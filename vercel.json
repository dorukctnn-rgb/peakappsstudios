        }
      ],
      "destination": "/legal/okultakip/privacy/index.html"
    },
    {
      "source": "/terms",
      "has": [
        {
          "type": "host",
          "value": "okultakip.peakappsstudio.com"
        }
      ],
      "destination": "/legal/okultakip/terms/index.html"
    },
    {
      "source": "/terms/:path*",
      "has": [
        {
          "type": "host",
          "value": "okultakip.peakappsstudio.com"
        }
      ],
      "destination": "/legal/okultakip/terms/index.html"
    }
  ]
